# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Dataset lokal (terlalu besar untuk Git)
# Abaikan seluruh isi dataset, tetapi izinkan .gitkeep agar struktur folder bisa disimpan.
/Model/dataset/**/*
!/Model/dataset/**/
!/Model/dataset/**/.gitkeep

# Video (rekaman dataset dan hasil capture)
*.avi
*.mp4
*.mov
*.mkv
*.webm
*.wmv
*.m4v

# Output models & logs - per task (letters, words)
Model/outputs/*/models/*
!Model/outputs/*/models/.gitkeep
Model/outputs/*/logs/
Model/outputs/*/figures/
Model/outputs/*/results/

# Misc
*.log
*.tmp
