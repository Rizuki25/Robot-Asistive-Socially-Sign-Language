# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Dataset (terlalu besar untuk Git) - per task (letters, words)
Model/dataset/*/raw/*
!Model/dataset/*/raw/.gitkeep
Model/dataset/*/landmarks/
Model/dataset/*/processed/

# Output models & logs - per task (letters, words)
Model/outputs/*/models/*
!Model/outputs/*/models/.gitkeep
Model/outputs/*/logs/
Model/outputs/*/figures/
Model/outputs/*/results/

# Misc
*.log
*.tmp
