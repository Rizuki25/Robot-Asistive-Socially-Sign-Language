# URL backend Socket.IO yang sudah online dan HTTPS.
# Contoh Render/Railway:
# VITE_SOCKET_URL=https://sign-language-socket.onrender.com
VITE_SOCKET_URL=

# Untuk backend Socket.IO, isi dengan URL frontend Vercel agar CORS lebih aman.
# Saat development lokal boleh dikosongkan atau pakai *.
# CLIENT_ORIGIN=https://nama-project.vercel.app
CLIENT_ORIGIN=*
