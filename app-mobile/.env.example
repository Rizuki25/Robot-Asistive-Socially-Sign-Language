# Opsional.
# Untuk Cloudflare Tunnel, kamu tidak wajib memakai file env.
# Kamu bisa membuka frontend dengan query:
# https://URL_FRONTEND_TUNNEL/?socketUrl=https%3A%2F%2FURL_BACKEND_TUNNEL

# Jika ingin diset permanen saat development/build, isi URL backend tunnel di sini.
# Contoh:
# VITE_SOCKET_URL=https://backend-demo.trycloudflare.com
VITE_SOCKET_URL=

# Backend CORS. Untuk Cloudflare quick tunnel/demo, boleh pakai *.
CLIENT_ORIGIN=*
